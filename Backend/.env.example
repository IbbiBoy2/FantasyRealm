# MariaDB configuration
DB_HOST=db
DB_PORT=3306
DB_NAME=fantasyrealm
DB_USER=fantasyrealm
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# MongoDB configuration
MONGODB_URI=mongodb://fantasyrealm:YOUR_MONGODB_PASSWORD@mongodb:27017/?authSource=admin
MONGODB_DATABASE=fantasyrealm

# Gmail SMTP configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
MAIL_FROM=your-address@gmail.com
MAIL_FROM_NAME="FantasyRealm"
MAIL_CONTACT_TO=your-address@gmail.com

# Application origin used for recovery links
APP_PUBLIC_URL=http://localhost:8080